import type { Category, Product } from "@/lib/commerce/types";
import { ButtonLink } from "../components/Button";
import { ProductCard } from "../components/ProductCard";

/** A selection of live-store products. Not labelled "best-sellers": no sales data exists. */
export function ProductsSection({ products, ranges }: { products: Product[]; ranges: Category[] }) {
  const rangeLabel = (id: string) => ranges.find((r) => r.id === id)?.label;
  return (
    <section aria-labelledby="products-title" className="bg-b-linen py-b-section">
      <div className="b-container">
        <div className="flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
          <div className="max-w-[40rem]">
            <h2 id="products-title" className="b-h2">
              Selected awards
            </h2>
            <p className="mt-4 max-w-[46ch] text-b-ink-2">Products and prices as listed in the current store. Prices include VAT.</p>
          </div>
          <ButtonLink href="#ranges" variant="outline">
            Browse all ranges
          </ButtonLink>
        </div>
        <ul className="mt-10 grid grid-cols-2 gap-x-3 gap-y-6 sm:gap-x-5 lg:grid-cols-4">
          {products.map((p) => (
            <li key={p.id} className="row-span-5 grid grid-rows-subgrid">
              <ProductCard product={p} rangeLabel={rangeLabel(p.categoryId)} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  );
}
